{
    "layer": "top",
    "position": "top",
    "height": 26,
    "modules-left": ["dwl/tags"],
    "modules-center": ["dwl/window"],
    "modules-right": ["tray", "clock"],

    "dwl/tags": {
        "num-tags": 9,
        "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9"]
    },
    "dwl/window": {
        "format": "{layout}  {title}",
        "max-length": 80
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "show-passive-items": true
    },
    "clock": {
        "format": "{:%H:%M}",
        "interval": 30
    }
}
